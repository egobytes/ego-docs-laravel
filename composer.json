{
    "name": "egobytes/ego-docs-laravel",
    "description": "Laravel integration for EGO docs: the in-app help assistant widget, signed user identity and shortcut catalog sync.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "help", "documentation", "chatbot", "widget", "support", "ego-docs"],
    "authors": [
        {
            "name": "EgoBytes"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "EgoBytes\\EgoDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EgoBytes\\EgoDocs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "EgoBytes\\EgoDocs\\EgoDocsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
